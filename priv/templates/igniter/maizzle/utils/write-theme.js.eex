const fs = require("fs")
const path = require("path")
const { paletteToThemeCss } = require("./palette")

const rootDir = path.join(__dirname, "..")
const config = require(path.join(rootDir, "config.js"))
const baseColors = config.maizzlex?.baseColors || {}
const outputPath = path.join(rootDir, "css", "generated-theme.css")

fs.writeFileSync(outputPath, paletteToThemeCss(baseColors), "utf8")
console.log(`Generated ${outputPath}`)
